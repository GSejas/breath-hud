{
  "name": "breathing-hud",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "author": "Breathing Shapes Team",
  "description": "Desktop breathing meditation HUD overlay application",
  "license": "MIT",
  "scripts": {
    "build": "tsc && webpack",
    "build:main": "tsc",
    "build:renderer": "webpack",
    "start": "electron dist/main/main.js",
    "dev": "npm run build && electron dist/main/main.js",
    "dev:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "package": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "electron": "^26.6.10"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^26.1.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.0.0",
    "webpack": "^5.101.2",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.breathingshapes.hud",
    "productName": "Breathing HUD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "breathing",
    "meditation",
    "mindfulness",
    "hud",
    "overlay",
    "desktop"
  ]
}
